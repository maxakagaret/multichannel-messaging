APP_NAME="Multichannel Messaging"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker Compose defaults (see ../docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=messaging
DB_USERNAME=messaging
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Messaging ---------------------------------------------------------------
# Channel drivers: only "fake" ships with the demo (see config/messaging.php).
MESSAGING_SMS_DRIVER=fake
MESSAGING_EMAIL_DRIVER=fake
MESSAGING_WHATSAPP_DRIVER=fake
MESSAGING_TELEGRAM_DRIVER=fake
MESSAGING_QUEUE=messaging
MESSAGING_DAILY_CAP=50
MESSAGING_TIMEZONE=UTC
# Sending window. Widened for the demo so messages flow at any hour.
MESSAGING_SEND_FROM=00:00
MESSAGING_SEND_UNTIL=23:59
# HMAC secret for provider webhooks — replace in any shared environment.
MESSAGING_WEBHOOK_SECRET=change-me

# Fake provider behaviour
FAKE_PERMANENT_FAILURE_PERCENT=8
FAKE_TRANSIENT_FAILURE_PERCENT=5
FAKE_SIMULATE_RECEIPTS=true
FAKE_RECEIPT_DELAY_SECONDS=5
# The fake provider reports these senders' accounts as restricted (quarantine demo).
FAKE_RESTRICTED_SENDERS="WA line 3"

# Sender health (defaults in config/messaging.php)
MESSAGING_WARMUP_URGENT_RESERVE=0.2
MESSAGING_QUARANTINE_THRESHOLD=3
MESSAGING_QUARANTINE_WINDOW_HOURS=24
MESSAGING_QUARANTINE_BURST_SECONDS=60
MESSAGING_QUARANTINE_HOURS=48
MESSAGING_BREAKER_FAILURES=3
MESSAGING_BREAKER_OPEN_SECONDS=60
MESSAGING_LINK_TOKEN_MINUTES=15

# Retention: messaging:prune runs nightly only when enabled.
MESSAGING_PRUNE_ENABLED=false
MESSAGING_RETENTION_DAYS=180
